/*
 * AcoustEEEcare — SD Card Isolated Test
 * xiao_ble_nrf52840_sense.overlay
 *
 * Uses the canonical &xiao_spi / &xiao_d abstractions from the board's
 * seeed_xiao_connector.dtsi — same as the official expansion board shield.
 * CS is D1 (xiao_d pin 1) to match your physical wiring.
 */

&xiao_spi {
    status = "okay";

    cs-gpios = <&xiao_d 1 GPIO_ACTIVE_LOW>;   /* D1 — your physical CS wire */

    sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        status = "okay";
        spi-max-frequency = <24000000>;  /* fix: was 400000 */
        power-delay-ms = <500>;          /* add: SD rail stabilization */

        mmc {
            compatible = "zephyr,sdmmc-disk";
            disk-name = "SD";
            status = "okay";
        };
    };
};