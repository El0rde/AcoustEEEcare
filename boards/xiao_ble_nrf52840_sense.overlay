/*
 * app.overlay — AcoustEEEcare hardware bindings
 * SPDX-License-Identifier: Apache-2.0
 *
 * v5.4 (was v5.3):
 *   - spi-max-frequency: 4 MHz -> 8 MHz. Combined with the larger
 *     SD_WRITE_BUF_SIZE (now 4096) and audio.pcm pre-allocation in
 *     main.c v7.5, this should eliminate sd_drops on most cards.
 *     If your specific SD module or wiring can't sustain 8 MHz, drop
 *     back to 4 MHz here — it's a hardware-quality knob.
 *
 *   - cs-gpios: CHECK YOUR PHYSICAL WIRING.
 *     Main.c v7.4 FIX 9 claims pin 1 is correct; this overlay had
 *     pin 2. Pick the one that matches what's on the breadboard.
 *     If both options work because the SD module's CS is tied to
 *     ground or pulled-up internally, prefer the documented FIX 9
 *     value (pin 1) for consistency.
 *
 * v5.3 (kept):
 *   Removed &adc { status = "okay" } node. nrfx_saadc bypasses the
 *   Zephyr ADC subsystem so CONFIG_ADC=n is fine.
 */

&xiao_spi {
    status = "okay";

    /* v5.4: VERIFY this matches the SD module's CS pin on the
     * breadboard. main.c FIX 9 documented pin 1; the original
     * overlay had pin 2. The right value is whichever matches the
     * actual wiring. */
    cs-gpios = <&xiao_d 1 GPIO_ACTIVE_LOW>;

    sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        status = "okay";
